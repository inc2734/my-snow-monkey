{
	"engines": {
		"node": ">=24.22.1",
		"npm": ">=11.19.1"
	},
	"volta": {
		"node": "24.22.1"
	},
	"author": "inc2734",
	"license": "GPL-2.0+",
	"devDependencies": {
		"@wordpress/env": "^12.0.0",
		"npm-run-all": "^4.1.5",
		"rimraf": "^4.4.0"
	},
	"scripts": {
		"wp-env": "wp-env",
		"start": "wp-env start && open http://localhost:8888",
		"stop": "wp-env stop",
		"destroy": "wp-env destroy && wp-env destroy --config=.wp-env.tests.json",
		"cli": "wp-env run cli --env-cwd=\"wp-content/plugins/my-snow-monkey\"",
		"wp": "npm run cli -- wp",
		"composer": "wp-env run cli --env-cwd=\"wp-content/plugins/my-snow-monkey\" composer",
		"clean:zip": "rimraf my-snow-monkey.zip",
		"test:php:start": "wp-env start --config=.wp-env.tests.json",
		"test:php:stop": "wp-env stop --config=.wp-env.tests.json",
		"test-composer": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/my-snow-monkey\" cli composer",
		"pretest:php:lint": "npm run test:php:start && npm run test-composer install -- --no-interaction",
		"test:php:lint": "wp-env run --config=.wp-env.tests.json --env-cwd=\"wp-content/plugins/my-snow-monkey\" wordpress composer run-script lint",
		"posttest:php:lint": "npm run test:php:stop",
		"test:lint:php": "npm run test:php:lint || (status=$?; npm run test:php:stop; exit $status)",
		"test:lint": "run-s test:lint:*",
		"test": "npm run test:lint",
		"zip:pack": "rsync -a --exclude='.*' --exclude='/my-snow-monkey' --exclude='node_modules' --exclude='vendor' --exclude='package.json' --exclude='package-lock.json' --exclude='composer.json' --exclude='composer.lock' . my-snow-monkey",
		"zip:archive": "zip -9 -qmr my-snow-monkey.zip my-snow-monkey",
		"zip": "npm run clean:zip && npm run zip:pack && npm run zip:archive"
	}
}
